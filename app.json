{
  "expo": {
    "name": "Pista",
    "slug": "pista",
    "scheme": "pista",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B0E1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pista.app"
    },
    "android": {
      "package": "com.pista.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0E1A"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pista usa tu ubicación solo cuando pulsas «Usar mi ubicación» para añadir un punto al mapa."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Pista",
      "shortName": "Pista",
      "themeColor": "#0B0E1A",
      "backgroundColor": "#0B0E1A"
    }
  }
}
