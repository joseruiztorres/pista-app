{
  "expo": {
    "name": "Pista",
    "slug": "pista",
    "scheme": "pista",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F1712"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pista.app"
    },
    "android": {
      "package": "com.pista.app"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pista usa tu ubicación solo cuando pulsas «Usar mi ubicación» para añadir un punto al mapa."
        }
      ]
    ]
  }
}
